          "start": 60.547308046153844,
          "end": 63.680000400000004
        },
        {
          "text": "Mỗi trợ lý chuyên một việc: nhập đơn, báo giá, viết email,",
          "start": 63.680000400000004,
          "end": 67.05848426410256
        },
        {
          "text": "không lẫn vào nhau.",
          "start": 67.11673398589744,
          "end": 68.2234787
        },
        {
          "text": "Lịch sử chat gọn theo từng việc, dễ tìm lại.",
          "start": 68.2234787,
          "end": 70.70337
        },
        {
          "text": "Và nhanh: mở ra là dán, cả team cùng một chuẩn.",
