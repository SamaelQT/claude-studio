    },
    {
      "index": 10,
      "start": 51.959565500000004,
      "end": 58.9282612,
      "caus": [
        {
          "text": "Từ giờ ai trong team mở trợ lý ra, chỉ việc dán tin nhắn.",
          "start": 51.989565500000005,
          "end": 54.885217700000005
        },
        {
          "text": "Không cần nhớ câu lệnh, bảng ra cùng một kiểu cột,",
          "start": 54.885217700000005,
          "end": 57.61883225223881
        },
        {
          "text": "gộp lại là xong.",
          "start": 57.673504543283585,
          "end": 58.548261200000006
