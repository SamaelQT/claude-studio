          "end": 44.926087200000005
        },
        {
          "text": "Năm phút là xong.",
          "start": 44.926087200000005,
          "end": 46.056522
        }
      ]
    },
    {
      "index": 9,
      "start": 46.436522000000004,
      "end": 51.959565500000004,
      "caus": [
        {
          "text": "Hướng dẫn mẫu đây.",
          "start": 46.466522000000005,
          "end": 47.4926089
        },
        {
          "text": "Điểm khác mẹo một: không chắc hôm nay ngày mấy thì trợ lý phải hỏi lại,",
