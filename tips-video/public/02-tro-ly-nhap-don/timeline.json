      "end": 8.3078261,
      "caus": [
        {
          "text": "Mẹo số một giúp bạn biến tin nhắn thành bảng.",
          "start": 1.6300000000000001,
          "end": 3.8626087
        },
        {
          "text": "Nhưng mỗi lần mở chat mới lại phải dán lại câu lệnh,",
          "start": 3.8626087,
          "end": 6.087780329473684
        },
        {
          "text": "còn mỗi người trong team lại hỏi một kiểu.",
          "start": 6.130572091578948,
          "end": 7.927826100000001
        }
      ]
    },
    {
      "index": 2,
      "start": 8.3078261,
      "end": 14.156956600000001,
      "caus": [
        {
          "text": "Người thì gõ làm bảng giùm, người thì tổng hợp đơn.",
          "start": 8.3378261,
          "end": 10.9182609
        },
        {
          "text": "Kết quả mỗi người một kiểu cột, gộp lại mất công làm lại.",
          "start": 10.9182609,
          "end": 13.7769566
        }
      ]
    },
    {
      "index": 3,
      "start": 14.156956600000001,
      "end": 19.1800001,
      "caus": [
        {
          "text": "Mẹo hôm nay: đóng gói câu lệnh thành một trợ lý riêng.",
          "start": 14.1869566,
          "end": 16.8978262
        },
        {
          "text": "Cài một lần, cả team dùng chung.",
          "start": 16.8978262,
          "end": 18.800000100000002
        }
      ]
    },
    {
      "index": 4,
      "start": 19.1800001,
      "end": 25.8986958,
      "caus": [
        {
          "text": "Một: mở mục tạo trợ lý.",
          "start": 19.210000100000002,
          "end": 21.0078262
        },
        {
          "text": "Gemini gọi là Gem, ChatGPT là GPT tuỳ chỉnh, Copilot là Agent.",
          "start": 21.0078262,
          "end": 25.5186958
        }
      ]
    },
    {
      "index": 5,
      "start": 25.8986958,
      "end": 30.8347828,
      "caus": [
        {
          "text": "Hai: dán câu lệnh vào ô hướng dẫn.",
          "start": 25.9286958,
          "end": 28.1286958
        },
        {
          "text": "Trợ lý nhớ luôn, không phải dán lại nữa.",
          "start": 28.1286958,
          "end": 30.454782799999997
        }
      ]
    },
    {
      "index": 6,
      "start": 30.8347828,
      "end": 36.0208698,
      "caus": [
        {
          "text": "Ba: đính kèm file danh mục mã hàng.",
          "start": 30.8647828,
          "end": 32.9778263
        },
        {
          "text": "Trợ lý tự dò mã, mã lạ thì đánh dấu hỏi.",
          "start": 32.9778263,
          "end": 35.6408698
        }
      ]
    },
    {
      "index": 7,
      "start": 36.0208698,
      "end": 40.174348,
      "caus": [
        {
          "text": "Bốn: chia sẻ cho cả team.",
          "start": 36.0508698,
          "end": 37.882935
        },
        {
          "text": "Ai mở ra cũng ra cùng một kiểu bảng.",
          "start": 37.882935,
          "end": 39.794348
        }
      ]
    },
    {
      "index": 8,
      "start": 40.174348,
      "end": 46.436522000000004,
      "caus": [
        {
          "text": "Trông như thế này: đặt tên, dán hướng dẫn, đính kèm file mã hàng,",
          "start": 40.204348,
          "end": 44.13913066666667
